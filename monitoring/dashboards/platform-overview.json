      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status, currency) (rate(payflow_payments_total[5m]))",
          "legendFormat": "{{status}} {{currency}}"
        }
      ]
    },
